#!/bin/bash
# Copy the current Omarchy desktop wallpaper to where the SDDM login theme
# (omarchy-wallpaper) reads it. Video wallpapers use a still frame.
set -euo pipefail

link="$HOME/.local/state/omarchy/current/background"
out_dir=/var/lib/omarchy-login-wallpaper
out="$out_dir/background.jpg"

[[ -e $link ]] || exit 0
src=$(realpath "$link")
sig="$src:$(stat -Lc %Y:%s "$src")"
[[ -f $out && -f $out_dir/.source && $(<"$out_dir/.source") == "$sig" ]] && exit 0

tmp=$(mktemp "$out_dir/.bg-XXXXXX.jpg")
trap 'rm -f "$tmp"' EXIT
case "${src,,}" in
  *.mp4|*.webm|*.mkv|*.mov|*.avi)
    ffmpegthumbnailer -i "$src" -o "$tmp" -s 3000 -q 9 ;;
  *)
    magick "${src}[0]" -auto-orient -resize '3000x3000>' -quality 90 "$tmp" ;;
esac
chmod 644 "$tmp"
mv -f "$tmp" "$out"
trap - EXIT
printf '%s\n' "$sig" > "$out_dir/.source"
echo "Login wallpaper set from $src"
